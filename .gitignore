__pycache__/
*.py[cod]

# Operational backups and local recovery plaintext must never enter source control.
*.snbak
*.snbak.*.partial
*.dump
/backups/
/recovery/
.env.backup

# Supabase CLI local cache and connection metadata.
/supabase/.temp/

# Windows scanner connector build outputs.
/tools/scanner-connector/**/bin/
/tools/scanner-connector/**/obj/
/tools/scanner-connector/dist/
/tools/scanner-connector/artifacts/
