# Copy to local.env (ignored by Git). Server-to-server key: never place in HTML.
SNOTE_OPERATOR_OCR_PROVIDER=self
SNOTE_SELF_OCR_URL=http://127.0.0.1:8765/ocr/vehicle-registration
SNOTE_OCR_ALLOW_LOCALHOST=1
SNOTE_OCR_MODEL_DIR=/absolute/path/to/prepared/models
SNOTE_OCR_SERVICE_TOKEN=
# Public project settings must match the existing operator.html login project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_EXISTING_PUBLIC_PUBLISHABLE_KEY
